{
  "name": "@vlln/dsh-home",
  "description": "把 DSH 首页换成可自排的小组件仪表盘：最近活跃会话、今日时间带、在跑/在等、节律。",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.mjs",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "vlln",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "home",
    "dashboard",
    "widgets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/dsh-home.git"
  },
  "homepage": "https://github.com/vlln/dsh-home#readme",
  "bugs": {
    "url": "https://github.com/vlln/dsh-home/issues"
  }
}
