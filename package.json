{
  "name": "@vlln/dsh-home",
  "description": "DSH 任务工作台：跨工作目录的最近会话、会话状态、可编排小组件与时间统计。",
  "version": "0.58.2",
  "type": "module",
  "main": "lib/index.mjs",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples/widget-counter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./widgets": {
      "types": "./lib/types/widget-contract.d.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run check:assets && tsdown --config ./tsdown.config.ts && tsc -p tsconfig.widgets.json",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "test:host": "node scripts/verify-host.mjs --run",
    "prepublishOnly": "npm run build && npm test",
    "build:css": "node scripts/build-css.mjs",
    "vendor": "node scripts/vendor-boardui.mjs",
    "new:widget": "node scripts/new-widget.mjs",
    "check:assets": "node scripts/gen-ui-index.mjs --check && node scripts/prune-vendor.mjs --check && node scripts/check-assets.mjs",
    "check": "npm run check:assets && npm run typecheck && npm test",
    "gen:ui": "node scripts/gen-ui-index.mjs",
    "prune:vendor": "node scripts/prune-vendor.mjs",
    "prepack": "npm run prune:vendor && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.58.2",
    "react-grid-layout": "2.2.3",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "vlln",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "home",
    "dashboard",
    "widgets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/dsh-home.git"
  },
  "homepage": "https://github.com/vlln/dsh-home#readme",
  "bugs": {
    "url": "https://github.com/vlln/dsh-home/issues"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0"
  }
}
